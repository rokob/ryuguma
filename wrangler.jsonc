// Cloudflare deploy config. The site is served as static assets only, with no
// Worker script, by Workers Builds on every push to main (see README).
{
  "name": "ryuguma",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "ryuguma.com", "custom_domain": true }
  ]
}
